{
  "name": "plastic-platoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "expo:web": "expo start --web",
    "probe": "node scripts/perf-probe.mjs",
    "pwa:check": "node scripts/check-pwa.mjs",
    "save:check": "node scripts/check-save-flows.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "review": "node scripts/review-screenshots.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "expo": "~57.0.11",
    "expo-status-bar": "~3.0.9",
    "pixi.js": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
